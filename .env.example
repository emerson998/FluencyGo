# Opcional: notas reais de pronúncia a partir do áudio (Azure Speech).
# Recurso com endpoint https://SEU_RECURSO.cognitiveservices.azure.com
AZURE_SPEECH_KEY=
AZURE_SPEECH_RESOURCE=
# PORT=3210

# Modo Cena (sempre Claude CLI). Modelo do Claude na cena: haiku responde em ~2 s por turno.
# CLAUDE_SCENE_MODEL=haiku
# Voz grátis e local: servidor HTTP do Piper (veja "Modo Cena" no README). Um servidor atende as três vozes.
# Só endereços http://127.0.0.1 ou http://localhost são aceitos.
# PIPER_URL=http://127.0.0.1:5001
# Opcional: outra voz por idioma, ou um servidor separado para uma voz.
# PIPER_VOICE_EN=en_US-lessac-medium
# PIPER_VOICE_ES=es_MX-claude-high
# PIPER_VOICE_PT=pt_BR-faber-medium
# PIPER_URL_ES=http://127.0.0.1:5002
# Tempo máximo de um turno fora do roteiro e tempo sem uso até fechar o Claude da cena (ms).
# SCENE_TURN_TIMEOUT_MS=25000
# SCENE_IDLE_MS=600000
